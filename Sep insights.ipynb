import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os, json
from collections import Counter
from math import log2

# ========== 1. Load Dataset ==========
df = pd.read_csv("customer_churn_dataset.csv")

# ========== 2. Create Output Folders ==========
for folder in ["plots/numerical", "plots/categorical", "plots/datetime", "insights"]:
    os.makedirs(folder, exist_ok=True)

# ========== 3. Helper Functions ==========

def calc_entropy(series):
    counts = series.value_counts(normalize=True)
    return float(-sum(p * log2(p) for p in counts if p > 0))

def detect_outliers(series):
    q1, q3 = series.quantile([0.25, 0.75])
    iqr = q3 - q1
    lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr
    outliers = series[(series < lower) | (series > upper)]
    return len(outliers), len(outliers) / len(series) * 100

def avg_gap(series):
    sorted_dates = series.dropna().sort_values().unique()
    if len(sorted_dates) < 2:
        return None, None
    gaps = np.diff(sorted_dates).astype("timedelta64[D]").astype(int)
    return float(np.mean(gaps)), float(np.median(gaps))

# ========== 4. Column Classification ==========
num_cols = df.select_dtypes(include=['int64', 'float64']).columns.tolist()
cat_cols = df.select_dtypes(include=['object', 'category']).columns.tolist()
date_cols = df.select_dtypes(include=['datetime64']).columns.tolist()

# Try to parse date-like object columns
for col in cat_cols.copy():
    try:
        df[col] = pd.to_datetime(df[col])
        date_cols.append(col)
        cat_cols.remove(col)
    except:
        pass

print("Numerical Columns:", num_cols)
print("Categorical Columns:", cat_cols)
print("Datetime Columns:", date_cols)

# ========== 5. Processors ==========

def process_numerical(col):
    s = df[col].dropna()
    outlier_count, outlier_pct = detect_outliers(s)

    stats = {
        "type": "numerical",
        "count": int(s.count()),
        "missing_count": int(df[col].isna().sum()),
        "missing_pct": float(df[col].isna().mean()*100),
        "mean": float(s.mean()),
        "median": float(s.median()),
        "std": float(s.std()),
        "min": float(s.min()),
        "max": float(s.max()),
        "unique_values": int(s.nunique()),
        "skewness": float(s.skew()),
        "kurtosis": float(s.kurt()),
        "outlier_count": int(outlier_count),
        "outlier_pct": float(outlier_pct)
    }

    # Plot: choose histogram if continuous else boxplot
    plt.figure(figsize=(6,4))
    if stats["unique_values"] > 20 and outlier_pct < 5:
        sns.histplot(s, kde=True, bins=30)
        plt.title(f"Histogram of {col}")
    else:
        sns.boxplot(x=s)
        plt.title(f"Boxplot of {col}")
    plt.tight_layout()
    plt.savefig(f"plots/numerical/{col}.png")
    plt.close()

    return stats


def process_categorical(col):
    s = df[col].dropna()
    value_counts = s.value_counts()
    percentages = s.value_counts(normalize=True)*100
    mean_freq = float(value_counts.mean())
    median_freq = float(value_counts.median())
    max_cat = value_counts.idxmax() if not value_counts.empty else None
    max_pct = float(percentages.max()) if not percentages.empty else None

    stats = {
        "type": "categorical",
        "count": int(s.count()),
        "missing_count": int(df[col].isna().sum()),
        "missing_pct": float(df[col].isna().mean()*100),
        "unique_values": int(s.nunique()),
        "most_frequent": {max_cat: int(value_counts.max())} if max_cat else None,
        "least_frequent": value_counts.tail(1).to_dict(),
        "mean_frequency": mean_freq,
        "median_frequency": median_freq,
        "entropy": calc_entropy(s),
        "max_category_pct": max_pct
    }

    # Plot: Pie if small & balanced, else bar
    plt.figure(figsize=(6,4))
    if stats["unique_values"] <= 5 and stats["max_category_pct"] < 80:
        value_counts.plot(kind="pie", autopct='%1.1f%%')
        plt.title(f"Pie Chart of {col}")
        plt.ylabel("")
    else:
        value_counts.head(10).plot(kind="bar")
        plt.title(f"Bar Chart of {col} (Top 10)")
        plt.ylabel("Count")
    plt.tight_layout()
    plt.savefig(f"plots/categorical/{col}.png")
    plt.close()

    return stats


def process_datetime(col):
    s = pd.to_datetime(df[col], errors='coerce').dropna()
    min_date, max_date = (str(s.min()), str(s.max())) if not s.empty else (None, None)
    avg_gap_days, median_gap_days = avg_gap(s)

    stats = {
        "type": "datetime",
        "count": int(s.count()),
        "missing_count": int(df[col].isna().sum()),
        "missing_pct": float(df[col].isna().mean()*100),
        "min_date": min_date,
        "max_date": max_date,
        "time_span_days": int((s.max() - s.min()).days) if not s.empty else None,
        "most_frequent_date": str(s.value_counts().idxmax()) if not s.empty else None,
        "repeated_dates": int((s.value_counts() > 1).sum()),
        "avg_gap_days": avg_gap_days,
        "median_gap_days": median_gap_days
    }

    # Plot: Trend line
    try:
        df_sorted = df[[col]].copy()
        df_sorted['count'] = 1
        df_trend = df_sorted.groupby(col).count()
        plt.figure(figsize=(8,4))
        plt.plot(df_trend.index, df_trend['count'])
        plt.title(f"Trend of {col}")
        plt.xlabel("Date")
        plt.ylabel("Count")
        plt.tight_layout()
        plt.savefig(f"plots/datetime/{col}.png")
        plt.close()
    except:
        pass

    return stats

# ========== 6. Generate Insights ==========

numerical_insights = {col: process_numerical(col) for col in num_cols}
categorical_insights = {col: process_categorical(col) for col in cat_cols}
datetime_insights = {col: process_datetime(col) for col in date_cols}

# Save separately
with open("insights/numerical_insights.json", "w") as f:
    json.dump(numerical_insights, f, indent=4)

with open("insights/categorical_insights.json", "w") as f:
    json.dump(categorical_insights, f, indent=4)

with open("insights/datetime_insights.json", "w") as f:
    json.dump(datetime_insights, f, indent=4)

# Save merged
all_insights = {
    "numerical": numerical_insights,
    "categorical": categorical_insights,
    "datetime": datetime_insights
}
with open("insights/all_insights.json", "w") as f:
    json.dump(all_insights, f, indent=4)

print("✅ Plots and JSON insights saved successfully!")
